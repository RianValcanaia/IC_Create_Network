# Artefatos gerados em runtime — não versionar

# Binários do Fabric (baixados por scripts/check_reqs.sh via install-fabric.sh)
bin/

# Rede gerada a cada deploy (crypto, compose, artefatos de canal, logs do SLURM)
network/

# Chaincode compilado e pacotes CCAAS gerados por deploy_chaincode.sh
chaincode/*/chaincode
chaincode/*.tar.gz

# Logs e caches
scripts/log_tx.txt
*.log
__pycache__/
*.pyc

# Scripts gerados pelos geradores a cada execução
scripts/register_enroll.sh
scripts/create_artifacts.sh
scripts/create_channel.sh
scripts/deploy_chaincode.sh
scripts/start_chaincodes.sh
