/bin/

# --- Artefatos de runtime da(s) rede(s) (layout network/<pasta> por rede) ---
network/*
!network/.gitkeep

# --- Scripts gerados dinamicamente pelos *Generator (recriados a cada --up) ---
scripts/register_enroll.sh
scripts/create_artifacts.sh
scripts/create_channel.sh
scripts/deploy_chaincode.sh
scripts/redeploy_chaincode.sh
scripts/start_chaincodes.sh

# --- Artefatos de chaincode gerados pelo ChaincodeDeployGenerator ---
chaincode/*.tar.gz
chaincode/*_collections.json
chaincode/*/chaincode

# --- Cache do Python ---
__pycache__/
*.pyc

# --- Diversos ---
.DS_Store

# --- Configuração local do Claude Code ---
.claude/
.gitignore
